# Copy to .env and fill in. .env is gitignored.

# MySQL connection string used by Prisma and the app.
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/projectmanagementapp"

# Secret used to sign session JWTs. Generate one with:
#   npx auth secret
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Canonical origin. Required in production; optional locally.
# AUTH_URL="https://example.com"

# Password given to every account created by `npm run db:seed` (8+ chars).
SEED_PASSWORD=""
